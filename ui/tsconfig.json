{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "useDefineForClassFields": false,
        "experimentalDecorators": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "types": ["vite/client"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
