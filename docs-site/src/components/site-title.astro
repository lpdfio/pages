---
// Replaces Starlight's site title with the lockup the lpdf.io header uses: the mark at 24px,
// the word in Radley, then the section label and the code language picker. The lockup goes to
// the lpdf.io home page, as the site's own does, and the label to the docs home, so either is
// one click from any docs page.
import mark from '../assets/lpdf-mark.svg';
import buildInfo from '../build-info.json';
import CodeLangSelect from './code-lang-select.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;

// The core the docs describe and the revision of this build, like v0.22-r0930.3. Both come from
// scripts/build-info.mjs, and either is left out when it is not known. How far the engine is past
// the release is only in the hover text, since most readers do not need it.
const { engine, revision } = buildInfo;
const plural = (n: number) => `${n} commit${n === 1 ? '' : 's'}`;
const version = engine ? `v${engine.engine}` : '';
const stamp = [version, revision].filter(Boolean).join('-');
const detail = [
    engine && `Docs for the Lpdf ${engine.engine} engine` + (engine.ahead ? `, ${plural(engine.ahead)} past ${engine.release} (${engine.commit})` : ` (${engine.release})`),
    revision && `Docs revision ${revision}`,
].filter(Boolean).join('. ');
---

<div class="brand">
    <a href="/" class="site-title">
        <img src={mark.src} width={mark.width} height={mark.height} alt="" />
        <span class="word" translate="no">Lpdf</span>
    </a>
    <a href={siteTitleHref} class="label">Docs</a>
    <CodeLangSelect />
    {stamp && <span class="stamp" title={detail}>{stamp}</span>}
</div>

<style>
    .brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }
    /* The same structure as lpdf.io's .nav-logo: the gap is 0.42em of the link's own text size,
       and the word sets its own 1.125rem below. Putting the size on the link instead made the
       gap 7.56px against the site's 6.72px. The mark is a little taller than the cap height so
       it leads the pair. */
    .site-title {
        display: flex;
        align-items: center;
        gap: 0.42em;
        color: var(--sl-color-white);
        text-decoration: none;
        white-space: nowrap;
    }
    img {
        height: 24px;
        width: auto;
        flex: none;
    }
    .word {
        font-family: 'Radley', Georgia, serif;
        font-weight: 600;
        font-size: 1.125rem;
        line-height: 1;
    }
    /* Turns the brand orange on hover, like the header's icons, since it is a link now. */
    .label {
        padding-inline-start: 1rem;
        border-inline-start: 1px solid var(--sl-color-gray-5);
        color: var(--sl-color-white);
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
        transition: color 0.15s;
    }
    .label:hover {
        color: var(--lpdf-brand);
    }
    /* Quiet: it is for whoever wants to know which core the page is for and how recent it is. */
    .stamp {
        color: var(--sl-color-gray-2);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        cursor: default;
    }
    /* Below 360px the label would push the picker under the search button, so it gives way. */
    @media (max-width: 22.49rem) {
        .label {
            display: none;
        }
    }
    /* The stamp sits between the picker and the centred search box, so it goes before they meet. */
    @media (max-width: 64rem) {
        .stamp {
            display: none;
        }
    }
</style>
